{
  "name": "space-launch-tracker-mcp",
  "version": "1.0.0",
  "description": "MCP server: upcoming launches, countdowns, Starship status, ISS and Starlink visible passes",
  "main": "dist/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main-http.js",
    "start:stdio": "node dist/main-stdio.js",
    "dev": "tsx src/main-http.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "space",
    "launch",
    "starlink",
    "iss",
    "starship",
    "grok"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "satellite.js": "^7.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "bin": {
    "space-launch-tracker-mcp": "dist/main-stdio.js"
  },
  "engines": {
    "node": ">=18"
  }
}
